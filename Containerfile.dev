# Dev image — the host is bootc (Fedora atomic) and has no GTK dev headers.
# Build:  podman build -t satori-dev -f Containerfile.dev
# Check:  podman run --rm -v "$PWD:/srv:Z" -w /srv satori-dev cargo check --workspace
# (:Z relabels the mount for SELinux on atomic hosts.)
# The vulkan/wayland/fontconfig/clang packages exist for the GPUI UI crate
# (crates/app-gpui, D13); gtk4/libadwaita remain for crates/app until P4.

FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install \
        rust cargo \
        clippy \
        gtk4-devel \
        libadwaita-devel \
        pkgconf-pkg-config \
        git \
        vulkan-devel \
        wayland-devel \
        libxkbcommon-devel \
        libxkbcommon-x11-devel \
        fontconfig-devel \
        libxcb-devel \
        clang \
        ydotool \
    && dnf -y clean all

WORKDIR /srv

# Persist the cargo registry/targets cache across container runs.
ENV CARGO_HOME=/usr/local/cargo
RUN mkdir -p /usr/local/cargo
